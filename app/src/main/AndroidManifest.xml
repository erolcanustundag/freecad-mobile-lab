<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:glEsVersion="0x00030000" android:required="false" />
    <application android:name=".CrashApplication" android:theme="@style/AppTheme" android:label="FreeCAD Mobile Lab" android:icon="@drawable/ic_app" android:allowBackup="false" android:supportsRtl="true" android:hardwareAccelerated="false" android:extractNativeLibs="true">
        <activity android:name=".StartupActivity" android:exported="true" android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity>
        <activity android:name=".MainActivity" android:process=":cad" android:exported="false" android:windowSoftInputMode="adjustResize" android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity android:name=".CoreDocumentActivity" android:process=":freecad" android:exported="false" android:windowSoftInputMode="adjustResize" android:configChanges="orientation|screenSize|keyboardHidden" />
    </application>
</manifest>
